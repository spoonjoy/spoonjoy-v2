# Self-hosted Spoonjoy built from its source, for an owner who builds it themselves: self-host/compose.yaml
# builds this from the public repository (https://github.com/spoonjoy/spoonjoy-v2.git#main) while the published
# image at ghcr.io/spoonjoy/spoonjoy isn't open to everyone yet. Build context: the repository root. The first
# stage makes the same production build the Self-host Image workflow makes; the second is self-host/Dockerfile's,
# line for line, reading that build from the first stage (test/self-host/dockerfile-source.test.ts checks).
FROM node:22.23.5-trixie-slim@sha256:68c76cfad89921b927eae28ba21407475e29d0ce450afcdbe70c1532db042b64 AS app

# Installing builds a few native test tools from source where no prebuilt one fits.
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates git python3 make g++ \
  && rm -rf /var/lib/apt/lists/*
WORKDIR /src
RUN corepack enable && corepack prepare pnpm@10.28.1 --activate
COPY . .
# No PostHog key, and the client build is told analytics are off, as in the published image.
RUN pnpm install --frozen-lockfile && VITE_POSTHOG_DISABLED=1 pnpm run build

FROM node:22.23.5-trixie-slim@sha256:68c76cfad89921b927eae28ba21407475e29d0ce450afcdbe70c1532db042b64

ARG SPOONJOY_VERSION=dev
# workerd verifies the Worker's outbound HTTPS (Apple's sign-in keys, AI providers, OAuth) against
# the system's CA certificates, which the slim base leaves out.
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates \
  && rm -rf /var/lib/apt/lists/*
WORKDIR /app/self-host
COPY --from=app /src/self-host/package.json /src/self-host/package-lock.json ./
RUN npm ci --omit=dev --no-audit --no-fund && npm cache clean --force

WORKDIR /app
COPY --from=app /src/build ./build
COPY --from=app /src/migrations ./migrations
COPY --from=app /src/self-host/*.mjs ./self-host/
RUN echo '{"type":"module"}' > build/server/package.json \
  && mkdir -p /data && chown node:node /data

ENV NODE_ENV=production DATA_DIR=/data PORT=8080 SPOONJOY_VERSION=${SPOONJOY_VERSION}
LABEL org.opencontainers.image.title="Spoonjoy" \
  org.opencontainers.image.description="Self-hosted Spoonjoy: your recipes, cookbooks and shopping list on your own server." \
  org.opencontainers.image.source="https://github.com/spoonjoy/spoonjoy-v2" \
  org.opencontainers.image.version="${SPOONJOY_VERSION}"

USER node
VOLUME /data
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 CMD ["node", "/app/self-host/healthcheck.mjs"]
CMD ["node", "/app/self-host/server.mjs"]
