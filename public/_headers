# Cloudflare Workers static asset headers.
# Vite fingerprints every file under /assets/ with a content hash, so a URL there
# never changes meaning. Let browsers and the edge keep them for a year without
# revalidating. Unhashed files (sw.js, manifest, icons, images) keep the default
# revalidating policy.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Account emails load Fraunces and Source Serif from here (app/domains/platform/model/account-email.ts).
# A mail client reads the mail from another origin, so these fonts allow any origin.
/fonts/email/*
  Access-Control-Allow-Origin: *
